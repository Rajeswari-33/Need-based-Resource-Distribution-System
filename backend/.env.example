PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=setu_donations
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id
CLIENT_ORIGIN=http://localhost:5173

# SMTP email notifications (for Gmail, use smtp.gmail.com and a Google App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-google-app-password
EMAIL_FROM=Setu Donations <your-email@gmail.com>

# WhatsApp Automated Notifications
# Notifications are dynamically sent to each user's own linked WhatsApp number (from their profile).
# To send automated messages across WhatsApp, configure your preferred gateway:

# Option 1: Green-API (Free Developer Tier - sends to ANY linked number via QR code)
# GREEN_API_INSTANCE_ID=
# GREEN_API_TOKEN=

# Option 2: Meta WhatsApp Cloud API (Official - sends to ANY linked number)
# WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
# WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Option 3: Alternative WhatsApp Gateway (UltraMsg, Wasapi) - Optional
# WHATSAPP_API_URL=https://api.ultramsg.com/instance/messages/chat
# WHATSAPP_API_KEY=your_gateway_key

# Option 4: CallMeBot (Free Personal Alerts) - Optional
# CALLMEBOT_API_KEY=
